# The mobile app (EXPO_PUBLIC_API_URL in the FE .env.example) calls http://localhost:3000 by default:
#   npm start   (PORT below)
PORT=3000
# development | staging | production
APP_ENV=development

# Bắt buộc ở môi trường không phải development (>= 32 ký tự, khác nhau, không phải giá trị mẫu)
JWT_SECRET=
REFRESH_TOKEN_SECRET=
SECRET_KEY=

# disabled | env
# env: tạo super admin từ SUPERADMIN_USERNAME / SUPERADMIN_PASSWORD nếu chưa có
SUPERADMIN_BOOTSTRAP_MODE=disabled
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=

MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB=explanatory_notes
REDIS_URL=redis://localhost:6379/0

# local | none
MEDIA_STORAGE_BACKEND=local
MEDIA_DIR=./runtime/media
RUNTIME_DIR=./runtime
STATIC_DIR=./runtime/static

AUDIO_TASK_STALE_SECONDS=900
MAINTENANCE_INTERVAL_SECONDS=60

# Audio / TTS
TTS_CACHE_DIR=./runtime/tts-cache
TTS_TIMEOUT_SECONDS=60
TTS_MAX_TEXT_CHARS=5000
AUDIO_MAX_CONCURRENCY=3
AUDIO_POLL_INTERVAL_SECONDS=2
AUDIO_SSE_POLL_SECONDS=1
MEDIA_PUBLIC_PREFIX=/media

# Authentication & RBAC
# AUTH_COOKIE_SECURE=true      # default: true outside development
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=

# Localization & UI bundles
LOCALIZATION_HOTSET_RADIUS_M=1500
LOCALIZATION_HOTSET_MAX_POIS=10
LOCALIZATION_HOTSET_REQUIRED=3
LOCALIZATION_TRANSLATE_CONCURRENCY=3
LOCALIZATION_QUEUE_MAX=1000
LOCALIZATION_ON_DEMAND_WAIT_SECONDS=5
LOCALIZATION_FAILURE_COOLDOWN_SECONDS=60
LOCALIZATION_RATE_LIMIT_REQUESTS=30
LOCALIZATION_RATE_LIMIT_WINDOW_SECONDS=60
LOCALIZATION_WARMUP_COOLDOWN_SECONDS=300
UI_BUNDLE_LOCK_SECONDS=600
UI_BUNDLE_FAILURE_COOLDOWN_SECONDS=300

# Absolute base URL for audio URLs sent to the app (empty: taken from the request)
PUBLIC_BASE_URL=
# CORS for browser clients such as Expo web, comma separated ("*" = any; empty = any in development only)
CORS_ALLOW_ORIGINS=
