{
  "expo": {
    "name": "Explanatory Notes Auto",
    "slug": "explanatory-notes-auto",
    "version": "0.1.0",
    "orientation": "portrait",
    "sdkVersion": "58.0.0",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.explanatorynotesauto.app"
    },
    "plugins": [
      "expo-status-bar",
      "expo-audio",
      "expo-sqlite"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Explanatory Notes Auto",
      "shortName": "NotesAuto",
      "themeColor": "#007aff",
      "backgroundColor": "#ffffff",
      "display": "standalone",
      "orientation": "portrait"
    }
  }
}
